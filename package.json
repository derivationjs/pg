{
  "name": "@derivation/pg",
  "version": "0.5.1",
  "description": "PostgreSQL persistence for derivation logs",
  "author": "Daniel Waterworth",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsup",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepack": "rm -rf dist && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "derivation": "^0.5.1",
    "@derivation/composable": "^0.5.1",
    "immutable": "^5.1.4",
    "postgres": "^3.4.8",
    "zod": "^4.3.6"
  }
}
